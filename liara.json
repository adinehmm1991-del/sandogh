{
  "platform": "django",
  "app": "sandogh-server",
  "platformConfig": {
    "application": "config.wsgi",
    "pythonVersion": "3.10",
    "djangoSettingsModule": "config.settings"
  },
  "args": [
    "sh",
    "-c",
    "python manage.py collectstatic --noinput --clear && gunicorn config.wsgi:application --bind 0.0.0.0:$PORT"
  ],
  "disks": [
    {
      "name": "data",
      "mountTo": "/usr/src/app/media"
    }
  ]
}